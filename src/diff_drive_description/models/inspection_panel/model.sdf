<?xml version="1.0"?>
<sdf version="1.9">
  <model name="inspection_panel">
    <static>true</static>

    <!--
      Semantic class 1: inspection_panel.  Gazebo's Label system applies this
      class to every visual in each included copy of this model.  Unlabelled
      warehouse objects remain background (label 0).
    -->
    <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
      <label>1</label>
    </plugin>

    <link name="panel_link">
      <!-- The front of the panel points along the model's +X axis. -->
      <collision name="cabinet_collision">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><box><size>0.35 0.90 1.70</size></box></geometry>
      </collision>

      <visual name="cabinet">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><box><size>0.35 0.90 1.70</size></box></geometry>
        <material><diffuse>0.58 0.61 0.64 1</diffuse></material>
      </visual>
      <visual name="front_plate">
        <pose>0.181 0 1.02 0 0 0</pose>
        <geometry><box><size>0.018 0.72 1.02</size></box></geometry>
        <material><diffuse>0.07 0.09 0.11 1</diffuse></material>
      </visual>

      <!-- Cyan screen and orange border provide shape features beyond red. -->
      <visual name="screen">
        <pose>0.194 0 1.29 0 0 0</pose>
        <geometry><box><size>0.015 0.46 0.28</size></box></geometry>
        <material>
          <ambient>0.03 0.42 0.55 1</ambient>
          <diffuse>0.04 0.68 0.82 1</diffuse>
          <emissive>0.01 0.16 0.22 1</emissive>
        </material>
      </visual>
      <visual name="border_top">
        <pose>0.195 0 1.57 0 0 0</pose>
        <geometry><box><size>0.02 0.73 0.055</size></box></geometry>
        <material><diffuse>0.92 0.42 0.05 1</diffuse></material>
      </visual>
      <visual name="border_bottom">
        <pose>0.195 0 0.50 0 0 0</pose>
        <geometry><box><size>0.02 0.73 0.055</size></box></geometry>
        <material><diffuse>0.92 0.42 0.05 1</diffuse></material>
      </visual>
      <visual name="border_left">
        <pose>0.195 0.34 1.035 0 0 0</pose>
        <geometry><box><size>0.02 0.055 1.02</size></box></geometry>
        <material><diffuse>0.92 0.42 0.05 1</diffuse></material>
      </visual>
      <visual name="border_right">
        <pose>0.195 -0.34 1.035 0 0 0</pose>
        <geometry><box><size>0.02 0.055 1.02</size></box></geometry>
        <material><diffuse>0.92 0.42 0.05 1</diffuse></material>
      </visual>

      <!-- Status indicators and emergency button. -->
      <visual name="indicator_green">
        <pose>0.215 0.22 0.81 0 0 0</pose>
        <geometry><sphere><radius>0.055</radius></sphere></geometry>
        <material>
          <diffuse>0.05 0.82 0.22 1</diffuse>
          <emissive>0.01 0.24 0.05 1</emissive>
        </material>
      </visual>
      <visual name="indicator_amber">
        <pose>0.215 0 0.81 0 0 0</pose>
        <geometry><sphere><radius>0.055</radius></sphere></geometry>
        <material><diffuse>0.95 0.68 0.05 1</diffuse></material>
      </visual>
      <visual name="indicator_red">
        <pose>0.215 -0.22 0.81 0 0 0</pose>
        <geometry><sphere><radius>0.055</radius></sphere></geometry>
        <material><diffuse>0.90 0.05 0.04 1</diffuse></material>
      </visual>
      <visual name="emergency_button_base">
        <pose>0.205 0 0.63 0 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.05</length></cylinder></geometry>
        <material><diffuse>0.92 0.74 0.06 1</diffuse></material>
      </visual>
      <visual name="emergency_button">
        <pose>0.235 0 0.63 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>0.85 0.04 0.03 1</diffuse></material>
      </visual>

      <visual name="base_plinth">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry><box><size>0.55 1.05 0.12</size></box></geometry>
        <material><diffuse>0.16 0.18 0.20 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
