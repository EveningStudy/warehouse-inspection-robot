<?xml version="1.0"?>
<sdf version="1.9">
  <model name="warehouse_shelf">
    <static>true</static>
    <link name="shelf_link">
      <!--
        Navigation only needs the occupied volume, so a single box is used
        for collision while the visuals below make the shelf look detailed.
      -->
      <collision name="shelf_collision">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry>
          <box><size>0.8 4.0 2.0</size></box>
        </geometry>
      </collision>

      <!-- Four steel uprights. -->
      <visual name="post_front_left">
        <pose>0.35 1.95 1.0 0 0 0</pose>
        <geometry><box><size>0.08 0.08 2.0</size></box></geometry>
        <material><diffuse>0.18 0.22 0.27 1</diffuse></material>
      </visual>
      <visual name="post_front_right">
        <pose>0.35 -1.95 1.0 0 0 0</pose>
        <geometry><box><size>0.08 0.08 2.0</size></box></geometry>
        <material><diffuse>0.18 0.22 0.27 1</diffuse></material>
      </visual>
      <visual name="post_back_left">
        <pose>-0.35 1.95 1.0 0 0 0</pose>
        <geometry><box><size>0.08 0.08 2.0</size></box></geometry>
        <material><diffuse>0.18 0.22 0.27 1</diffuse></material>
      </visual>
      <visual name="post_back_right">
        <pose>-0.35 -1.95 1.0 0 0 0</pose>
        <geometry><box><size>0.08 0.08 2.0</size></box></geometry>
        <material><diffuse>0.18 0.22 0.27 1</diffuse></material>
      </visual>

      <!-- Shelf boards. -->
      <visual name="shelf_level_0">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry><box><size>0.8 4.0 0.08</size></box></geometry>
        <material><diffuse>0.32 0.37 0.43 1</diffuse></material>
      </visual>
      <visual name="shelf_level_1">
        <pose>0 0 0.62 0 0 0</pose>
        <geometry><box><size>0.8 4.0 0.08</size></box></geometry>
        <material><diffuse>0.32 0.37 0.43 1</diffuse></material>
      </visual>
      <visual name="shelf_level_2">
        <pose>0 0 1.14 0 0 0</pose>
        <geometry><box><size>0.8 4.0 0.08</size></box></geometry>
        <material><diffuse>0.32 0.37 0.43 1</diffuse></material>
      </visual>
      <visual name="shelf_level_3">
        <pose>0 0 1.66 0 0 0</pose>
        <geometry><box><size>0.8 4.0 0.08</size></box></geometry>
        <material><diffuse>0.32 0.37 0.43 1</diffuse></material>
      </visual>

      <!-- Visual-only packages add colour and structure. -->
      <visual name="package_blue">
        <pose>0 1.25 0.37 0 0 0</pose>
        <geometry><box><size>0.62 0.85 0.44</size></box></geometry>
        <material><diffuse>0.12 0.38 0.70 1</diffuse></material>
      </visual>
      <visual name="package_tan">
        <pose>0 0.10 0.37 0 0 0</pose>
        <geometry><box><size>0.62 1.05 0.44</size></box></geometry>
        <material><diffuse>0.62 0.45 0.25 1</diffuse></material>
      </visual>
      <visual name="package_grey">
        <pose>0 -1.25 0.37 0 0 0</pose>
        <geometry><box><size>0.62 0.85 0.44</size></box></geometry>
        <material><diffuse>0.42 0.44 0.47 1</diffuse></material>
      </visual>
      <visual name="package_yellow">
        <pose>0 0.75 0.89 0 0 0</pose>
        <geometry><box><size>0.62 0.72 0.42</size></box></geometry>
        <material><diffuse>0.85 0.62 0.12 1</diffuse></material>
      </visual>
      <visual name="package_green">
        <pose>0 -0.55 0.89 0 0 0</pose>
        <geometry><box><size>0.62 1.10 0.42</size></box></geometry>
        <material><diffuse>0.18 0.52 0.32 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
